NODE_ENV=development
PORT=5000

# MongoDB Atlas
MONGODB_URI=

# Authentication
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Frontend / realtime CORS
CLIENT_URL=http://localhost:5173
SOCKET_CORS_ORIGIN=http://localhost:5173

# OTP / rate limits
OTP_TTL_MINUTES=10
RATE_LIMIT_MAX=500
AUTH_RATE_LIMIT_MAX=100

# Admin bootstrap (only if the server seed/admin flow uses these)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=WORKFORCE Admin

# Private document storage. Leave R2 blank to use the local private_uploads fallback in development.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=workforce-files
R2_ENDPOINT=
PRIVATE_UPLOAD_DIR=private_uploads

# AI: provider C = OpenRouter primary, OpenAI fallback.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Optional infrastructure / integrations
REDIS_URL=
LOG_LEVEL=info

# Upload limits
MAX_CHAT_ATTACHMENT_MB=10
MAX_IMAGE_SIZE_MB=5
